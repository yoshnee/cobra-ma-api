# Anthropic API key for Claude Haiku vision + comparison
ANTHROPIC_API_KEY=sk-ant-...

# Cloudflare Turnstile secret key (leave empty to skip verification in local dev)
TURNSTILE_SECRET_KEY=

# Postgres connection string (Neon, pooled endpoint, read-only role)
DATABASE_URL=postgresql://cobra_api:<password>@<endpoint>-pooler.<region>.aws.neon.tech/cobra-ma?sslmode=require
